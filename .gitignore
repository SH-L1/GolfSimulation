# 1. 하위 프로젝트 폴더 내 임시 파일 제외
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/

# 2. VS Code 및 기타 설정
.vscode/
.DS_Store

# 3. 유니티가 생성하는 솔루션 파일들
*.csproj
*.sln
*.suo
node_modules/
.gradle/
*.iml

# Android 빌드 결과물
android/build/
android/app/build/
android/.cxx/
android/app/.cxx/
android/.gradle/

# Android 자동생성 autolinking 파일
android/build/generated/

# Android JS 번들 & 번들 빌드 리소스 (build-apk.ps1 생성)
android/app/src/main/assets/index.android.bundle
android/app/src/main/res/drawable-mdpi/
android/app/src/main/res/drawable-xhdpi/
android/app/src/main/res/drawable-xxhdpi/
android/app/src/main/res/drawable-xxxhdpi/
android/app/src/main/res/raw/

# 빌드 버전 자동증가 파일
android/version.properties

# Android 머신별 로컬 설정 / 서명 비밀번호 (절대 커밋 금지)
android/local.properties
android/gradle.properties

# 릴리즈 키스토어 (절대 커밋 금지)
android/app/*.keystore
!android/app/debug.keystore

# iOS 빌드 결과물
ios/build/
ios/Pods/
ios/DerivedData/

# Ruby / CocoaPods
vendor/bundle/

# Unity 빌드 결과물 (Unity 팀이 별도 관리)
Unity_PT/
/unity/

# OAuth 키 — 로컬에서만 관리 (절대 커밋 금지)
src/constants/oauth.ts

# ── Python (backend, tools, data 등 전체 적용) ────────────────────
# 환경변수 / 시크릿 (절대 커밋 금지)
backend/.env
backend/.env.*
!backend/.env.example

# 업로드된 실제 파일 (바이너리, 개인정보)
backend/tmp/
backend/output/

# Python 캐시 (프로젝트 전체)
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/*.egg-info/

# ── 프론트엔드 무관 디렉토리 (이 레포에서 제외) ────────────────────
